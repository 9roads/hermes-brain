#!/usr/bin/env bash
set -euo pipefail

if [ -z "${CODEX_HOME:-}" ]; then
  if [ -n "${LOISA_CODEX_HOME:-}" ]; then
    export CODEX_HOME="$LOISA_CODEX_HOME"
  elif [ -d /opt/data ] || mkdir -p /opt/data 2>/dev/null; then
    export CODEX_HOME=/opt/data/codex
  elif [ -n "${HOME:-}" ]; then
    export CODEX_HOME="$HOME/.codex"
  fi
fi

if [ -n "${CODEX_HOME:-}" ]; then
  mkdir -p "$CODEX_HOME" 2>/dev/null || true
fi

exec /opt/hermes/codex-cli/node_modules/.bin/codex "$@"
