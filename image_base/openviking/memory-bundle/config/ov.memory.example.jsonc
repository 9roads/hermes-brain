{
  // Example OpenViking config fragment for general Phoenix/Hermes memory.
  // Merge into ~/.openviking/ov.conf or your deployment-specific config file.

  "default_account": "default",
  "default_user": "default",
  "default_agent": "hermes-memory",

  "storage": {
    "workspace": "/srv/phoenix/openviking-data",
    "vectordb": {
      "name": "context",
      "backend": "local"
    },
    "agfs": {
      "backend": "local",
      "queuefs": {
        "mode": "shared",
        "backend": "sqlite",
        "db_path": "/srv/phoenix/openviking-data/_system/queue/queue.db",
        "busy_timeout_ms": 5000
      }
    }
  },

  "server": {
    "auth_mode": "api_key",
    "root_api_key": "${OPENVIKING_ROOT_API_KEY}"
  },

  "embedding": {
    "max_concurrent": 8,
    "max_retries": 3,
    "text_source": "content_only",
    "max_input_tokens": 4096,
    "dense": {
      "provider": "openai",
      "api_base": "${OPENAI_BASE_URL}",
      "api_key": "${OPENAI_API_KEY}",
      "model": "text-embedding-3-large",
      "dimension": 3072,
      "encoding_format": "float"
    }
  },

  "vlm": {
    "provider": "openai",
    "api_base": "${OPENAI_BASE_URL}",
    "api_key": "${OPENAI_API_KEY}",
    "model": "gpt-5.5",
    "max_concurrent": 4,
    "max_retries": 2,
    "timeout": 180,
    "extra_request_body": {
      "reasoning": {
        "effort": "medium"
      }
    }
  },

  "memory": {
    "version": "v2",
    "custom_templates_dir": "/srv/phoenix/openviking/company-memory"
  }

  // Optional rerank section. Add when you have a supported reranker available.
  // "rerank": {
  //   "provider": "openai",
  //   "api_key": "${OPENAI_API_KEY}",
  //   "model": "<your-rerank-compatible-model>"
  // }
}
